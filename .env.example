GEMINI_API_KEY=
MONGODB_URI=mongodb://127.0.0.1:27017
# optional
# GEMINI_MODEL=gemini-3.8-live
# PORT=3000

# Cost estimator: USD per 1M tokens (assumed; check ai.google.dev/pricing). Free tier bills 0.
RATE_TEXT_IN=0.5
RATE_TEXT_OUT=2
RATE_AUDIO_IN=3
RATE_AUDIO_OUT=12
USD_INR=85

# Optional keep-alive for sleeping free hosts (Render). Pings our own /health every 10 min until this date, then stops.
# Render sets RENDER_EXTERNAL_URL itself; elsewhere set PUBLIC_URL.
# KEEPALIVE_UNTIL=2026-11-14T00:00:00Z

# Set to 1 when deployed behind a reverse proxy (Render) so per-IP limits see the real visitor, not the proxy.
# TRUST_PROXY=1
